## many Welch's t-tests
## examine all continuous variables versus clima and non clima
vars <- as.matrix( x1[, c(2, 4:10)] )
head(vars)
x2 <- as.numeric(x2)
ttests(vars, ina = x2)  ## 2nd column contains the p-values
## Price for Clima versus non Clima cars
x2 <- as.factor( rbinom( length(y1), 1, 0.5 ) + 1 )
x2 <- as.numeric(x2)
z1 <- y1[x2 == 1]
z2 <- y1[x2 == 2]
t.test( z1, z2 ) ## correct t-test, Welch's t-test for unequal variances
vars <- as.matrix( x1[, c(2, 4:10)] )
v1 <- vars[x2 == 1, ]
v2 <- vars[x2 == 2, ]
ttests(v1, v2)  ## 2nd column contains the p-values
colnames(vars)
